# Copy to .env.local and fill in. Never commit .env.local.
# The station link is what serves the bridge over the network; the SoftAP is a
# fallback so the bridge stays reachable when no infrastructure network is.
WIFI_SSID=your-network
WIFI_PASSWORD=replace-with-local-password
WIFI_SSID_FALLBACK=optional-second-network
WIFI_PASSWORD_FALLBACK=replace-with-fallback-password
CONTROL_AP_SSID=esprobe
CONTROL_AP_PASSWORD=replace-with-at-least-8-characters

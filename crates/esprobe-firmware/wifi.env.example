# Copy to .env.local and fill in. Never commit .env.local.
#
# The regulatory domain the probe will be used in, as a two-letter country
# code. Required, and deliberately not defaulted: ESP-IDF's world-safe mode
# leaves this chip receiving but not transmitting, and defaulting to a real
# country would have everyone else transmitting under someone else's regulator.
WIFI_COUNTRY=NO

# The fallback access point, published only when the probe has no network to
# join. This pair is the one thing compiled into the image, so treat a built
# image as carrying it. The network the probe joins is not built in: provision
# it at runtime with `esprobe wifi set`, which stores it in NVS.
CONTROL_AP_SSID=esprobe
CONTROL_AP_PASSWORD=replace-with-at-least-8-characters

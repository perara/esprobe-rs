# Copy to .env.local and fill in. Never commit .env.local.
#
# Only the fallback access point is built into the image. The network the probe
# joins is provisioned at runtime with `esprobe wifi set`, so that no image ever
# carries a real passphrase and a probe can be repointed without a reflash.
CONTROL_AP_SSID=esprobe
CONTROL_AP_PASSWORD=replace-with-at-least-8-characters
